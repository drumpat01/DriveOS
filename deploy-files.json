{
  "schemaVersion": 1,
  "allowed": [
    "*.md", "*.txt", "*.json", "*.yaml", "*.yml", "*.ps1", "*.sh", "*.bat", "*.ico", ".env.example", "Dockerfile",
    ".github/workflows/**", "desktop/*.cs", "docs/**", "server/**", "src/**", "tests/**", "tools/**", "web/**"
  ],
  "forbidden": [
    ".env", "artifacts/**", "data/**", "desktop/packages/**", "update-backups/**",
    "WebView2Profile/**", "webview2profile/**", "**/*.exe", "**/*.dll", "**/*.pdb", "**/*.zip",
    "**/*.log", "**/*token*", "**/*secret*.json"
  ]
}
