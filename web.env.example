# DriveOS Web environment template
#
# This file contains placeholders only.
# Never commit real tokens, passwords, hashes, or encryption keys.

# Runtime
DRIVEOS_MODE=web
PORT=8787
DRIVEOS_DATA_DIR=/app/data

# Public URL
# Example after deployment:
# DRIVEOS_PUBLIC_URL=https://driveos-example.onrender.com
DRIVEOS_PUBLIC_URL=

# Owner authentication
DRIVEOS_OWNER_EMAIL=
DRIVEOS_PASSWORD_HASH=
DRIVEOS_AUTH_SECRET=
DRIVEOS_ENCRYPTION_KEY=

# Required integrations
TESSIE_TOKEN=
SPOTIFY_CLIENT_ID=

# Optional integrations
LASTFM_USERNAME=
LASTFM_API_KEY=
FOURSQUARE_API_KEY=

# Web security / behavior
DRIVEOS_SESSION_HOURS=24
DRIVEOS_TRUST_PROXY=true
