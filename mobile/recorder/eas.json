{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "v2-preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "channel": "v2-preview",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "v2-preview",
        "EXPO_PUBLIC_JOURNEYDECK_INTERNAL_TESTING": "0"
      },
      "ios": {
        "simulator": false
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_JOURNEYDECK_INTERNAL_TESTING": "1"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_JOURNEYDECK_INTERNAL_TESTING": "1"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "uploadSourceMaps": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_JOURNEYDECK_INTERNAL_TESTING": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6806502526"
      }
    }
  }
}
