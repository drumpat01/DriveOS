{
  "expo": {
    "name": "JourneyDeck",
    "slug": "journeydeck",
    "owner": "journeydeck",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ea19ed01-7b62-49e9-a9e3-8058f1e6cbd4",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "journeydeck-recorder",
    "platforms": ["ios"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.journeydeck.recorder",
      "infoPlist": {
        "NSAppleMusicUsageDescription": "JourneyDeck reads your Apple Music activity to build the soundtrack for journeys you record.",
        "NSMicrophoneUsageDescription": "JourneyDeck briefly listens for music you choose to recognize. Audio is never saved."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JourneyDeck uses your location to record the route of a journey you start.",
          "locationAlwaysAndWhenInUsePermission": "JourneyDeck records your route while your phone is locked or another app is open.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "JourneyDeck accesses photos you choose so you can add them to Collections and Memories.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "ea19ed01-7b62-49e9-a9e3-8058f1e6cbd4"
      }
    }
  }
}
